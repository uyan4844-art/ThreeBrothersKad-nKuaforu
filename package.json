{
  "name": "threebrothers-bayan-kuaforu",
  "version": "1.0.0",
  "description": "ThreeBrothers Bayan Kuaförü & Saç Tasarım Stüdyosu Web Sitesi",
  "main": "index.html",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build:css": "node ./node_modules/@tailwindcss/cli/dist/index.mjs -i ./src/input.css -o ./css/style.css --minify && node -e \"const fs=require('fs'); fs.mkdirSync('./public/css', {recursive:true}); fs.copyFileSync('./css/style.css', './public/css/style.css');\"",
    "build": "npm run build:css"
  },
  "keywords": [
    "kuaför",
    "manavgat",
    "bayan kuaförü",
    "ombre",
    "balyaj",
    "keratin"
  ],
  "author": "ThreeBrothers",
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "archiver": "^8.0.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3"
  }
}
